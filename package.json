{
  "name": "demo-reel",
  "version": "0.14.0",
  "description": "Create demo videos from web apps using Playwright",
  "keywords": [
    "automation",
    "cli",
    "demo",
    "playwright",
    "video"
  ],
  "homepage": "https://github.com/whit3st/demo-reel#readme",
  "bugs": {
    "url": "https://github.com/whit3st/demo-reel/issues"
  },
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whit3st/demo-reel.git"
  },
  "bin": {
    "demo-reel": "bin/demo-reel.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "helpers",
    ".claude-plugin"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./helpers/*": "./helpers/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsgo",
    "build:tsc": "tsc",
    "dev": "tsc --watch",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "oxlint .",
    "lint:ci": "oxlint .",
    "format": "oxfmt . --write",
    "format:ci": "oxfmt . --check",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "ffmpeg-static": "^5.3.0",
    "glob": "^14.0.6",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "dotenv": "^18.0.10",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.91.1 <2.0.0",
    "openai": "^4.0.0 || ^5.0.0 || ^7.0.0",
    "playwright": "^1.58.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
