{
  "name": "demo-reel",
  "version": "0.14.0",
  "description": "Create demo videos from web apps using Playwright",
  "keywords": [
    "automation",
    "cli",
    "demo",
    "playwright",
    "video"
  ],
  "homepage": "https://github.com/whit3st/demo-reel#readme",
  "bugs": {
    "url": "https://github.com/whit3st/demo-reel/issues"
  },
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whit3st/demo-reel.git"
  },
  "bin": {
    "demo-reel": "bin/demo-reel.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "helpers",
    ".claude-plugin"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./helpers/*": "./helpers/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsgo",
    "build:tsc": "tsc",
    "dev": "tsc --watch",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "coverage:badge": "node scripts/write-coverage-badge.mjs coverage/coverage-summary.json .github/badges/coverage.json",
    "security:audit": "pnpm audit --json --prod > audit.json || true",
    "security:badge": "node scripts/write-security-badge.mjs audit.json .github/badges/security.json",
    "lint": "oxlint .",
    "lint:ci": "oxlint .",
    "format": "oxfmt . --write",
    "format:ci": "oxfmt . --check",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "ffmpeg-static": "^5.3.0",
    "glob": "^13.0.6",
    "tsx": "^4.23.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "dotenv": "^17.4.2",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.91.1 <1.0.0",
    "openai": "^4.0.0 || ^5.0.0",
    "playwright": "^1.58.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@12.1.0+sha512.d9b8276d97f6ec86e49815877f91ee9f63cee61f2063b304e43b6dab8fa07ce8a9afd46d2facd39f921e6a9d06b3c75a81349c7b888c2d22886bae0229901037"
}
